# Copia este archivo a .env y rellena los valores reales.

# --- Conexion a SQL Server ---
DRIVER=SQL Server
SERVER=localhost
DATABASE=vendedores
UID=sa
PWD_SQL=CambiaEstaClave

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=pon-aqui-un-token-aleatorio
