# Copia este archivo a .env y rellena los valores reales.

# Conexion a SQL Server 
DRIVER=SQL Server
SERVER=localhost
DATABASE=vendedores
UID=sa
PWD_SQL=CambiaEstaClave

# Seguridad
API_TOKEN=pon-aqui-un-token-aleatorio

# Conexion a SharePoint (app registration con certificado, Microsoft Graph)
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CERT_PATH=certs/sharepoint.pem
CERT_THUMBPRINT=0000000000000000000000000000000000000000
# Opcional, tiene un valor por defecto en config.py
# SHAREPOINT_URL=https://intecsaindustrial.sharepoint.com/sites/DesarrolloAutomatizaciones/Comentarios
