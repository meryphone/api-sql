# Copy this file to .env and fill in the real values.

# SQL Server connection
DRIVER=SQL Server
SERVER=localhost
DATABASE=vendedores
UID=sa
PWD_SQL=ChangeThisPassword

# Security
API_TOKEN=put-a-random-token-here

# SharePoint connection (app registration with certificate, Microsoft Graph)
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CERT_PATH=certs/sharepoint.pem
CERT_THUMBPRINT=0000000000000000000000000000000000000000
# Optional, has a default value in config.py
# SHAREPOINT_URL=https://intecsaindustrial.sharepoint.com/sites/DesarrolloAutomatizaciones/Comentarios
